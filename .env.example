# GEMINI_API_KEY: Required for server-side Gemini AI agronomic synthesis & grounding routes.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DATABASE_URL: PostgreSQL connection string for Cloud SQL (Drizzle ORM).
# Automatically provisioned by AI Studio Cloud SQL setup.
DATABASE_URL="postgresql://user:password@localhost:5432/terrashift"

# GOOGLE_MAPS_API_KEY / VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key
# Used for Maps JavaScript API, Places API (New) Autocomplete, and Google Weather proxy.
GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# APP_URL: Public URL where the applet is hosted.
APP_URL="http://localhost:3000"
